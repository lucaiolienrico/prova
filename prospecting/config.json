{
  "_commento": "Configurazione pipeline PetNote Prospecting. Modificare qui i pesi di scoring, le categorie canoniche e le soglie di priorita'; poi rilanciare: python3 prospecting/process.py",

  "categories": [
    "Veterinari", "Cliniche veterinarie", "Ambulatori veterinari", "Ospedali veterinari",
    "Canili", "Rifugi per animali", "Associazioni animaliste", "Allevatori",
    "Allevamenti professionali", "Educatori cinofili", "Addestratori", "Centri cinofili",
    "Scuole per cani", "Pet shop", "Negozi per animali", "Toelettature",
    "Pensioni per animali", "Pet hotel", "Dog sitter", "Cat sitter",
    "Professionisti del comportamento animale", "Fisioterapisti veterinari",
    "Servizi di pet care", "Agenzie e servizi dedicati agli animali domestici"
  ],

  "base_score": {
    "Ospedali veterinari": 32, "Cliniche veterinarie": 30, "Ambulatori veterinari": 28,
    "Veterinari": 28, "Fisioterapisti veterinari": 26,
    "Professionisti del comportamento animale": 26, "Pet hotel": 27,
    "Pensioni per animali": 26, "Centri cinofili": 26, "Scuole per cani": 26,
    "Educatori cinofili": 24, "Addestratori": 24, "Toelettature": 23,
    "Pet shop": 23, "Agenzie e servizi dedicati agli animali domestici": 22,
    "Allevamenti professionali": 22, "Negozi per animali": 20, "Allevatori": 20,
    "Servizi di pet care": 20, "Canili": 18, "Rifugi per animali": 18,
    "Associazioni animaliste": 18, "Dog sitter": 18, "Cat sitter": 18,
    "_default": 20
  },

  "weights": {
    "website": 14,
    "email": 14,
    "phone": 12,
    "instagram_url": 8,
    "facebook_url": 7,
    "address": 8,
    "contact_name": 6,
    "subcategory": 3,
    "digital_channel": 4,          "rating_reviews": 6,         "social_reach": 6,           "updated_recent": 3,           "chain_group_penalty": -12,        "unverified_penalty_each": 3,        "unverified_penalty_cap": 2,       "old_source_penalty": 3            },

  "priority_thresholds": { "A+": 90, "A": 80, "B": 65, "C": 50 },
  "score_min": 5,
  "score_max": 100,

  "output": {
    "json": "petnote_prospects.json",
    "csv": "petnote_prospects.csv",
    "shortlist": "shortlist_AB.csv",
    "riepilogo": "riepilogo.txt"
  },

  "_comandi_h24": "Ricerca automatica H24 (GitHub Actions ogni 6h o manuale). Uso: python3 prospecting/find_candidates.py [--batch N | --cities 'Nome,Nome'] poi python3 prospecting/process.py",

  "cities_per_run": 6,
  "queue_file": "queue/cities.json",

  "overpass": {
    "_commento": "Solo OpenStreetMap (licenza ODbL): nessuno scraping di directory con termini d'uso restrittivi. Endpoint di fallback e cortesie di rate-limit.",
    "endpoints": [
      "https://overpass-api.de/api/interpreter",
      "https://overpass.kumi.systems/api/interpreter"
    ],
    "timeout_s": 60,
    "min_delay_s": 1.5,
    "max_retries": 3,
    "max_elements_per_city": 1500,
    "radius_by_population": [
      [1000000, 15000],
      [300000, 10000],
      [100000, 8000],
      [50000, 6000]
    ],
    "default_radius_m": 5000,
    "_recipe": "Ogni categoria ha 'queries': dentro una query i tag sono in AND (es. amenity=animal_shelter E shelter_type=dog), tra query in OR, tra categorie in UNION. In una query \"chiave\": \"*\" significa tag presente (qualsiasi valore). Prima categoria che combacia vince. Le categorie senza regola (dog sitter, educatori, ecc.) non hanno un tag OSM standard e NON vengono ricercate automaticamente: nessuno scraping di directory.",
    "recipe": [
      { "category": "Veterinari", "queries": [ { "amenity": "veterinary" }, { "healthcare": "veterinary" } ] },
      { "category": "Pet shop", "queries": [ { "shop": "pet" } ] },
      { "category": "Toelettature", "queries": [ { "shop": "pet_grooming" }, { "shop": "grooming" } ] },
      { "category": "Pensioni per animali", "queries": [ { "amenity": "animal_boarding" } ] },
      { "category": "Canili", "queries": [ { "amenity": "animal_shelter", "shelter_type": "dog" }, { "amenity": "animal_shelter", "animal": "dog" } ] },
      { "category": "Rifugi per animali", "queries": [ { "amenity": "animal_shelter" } ] },
      { "category": "Allevamenti professionali", "queries": [ { "amenity": "animal_breeding", "breed": "*" }, { "landuse": "animal_breeding", "breed": "*" } ] },
      { "category": "Allevatori", "queries": [ { "amenity": "animal_breeding" }, { "landuse": "animal_breeding" } ] }
    ]
  }
}
